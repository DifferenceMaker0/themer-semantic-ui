{
    "private": true,
    "type": "module",
    "main": "./dist/tsp-output/clients/js/src/index.js",
    "typings": "./dist/tsp-output/types/clients/js/src/index.d.ts",
    "resolutions": {
        "styled-components": "^5"
    },
    "scripts": {
        "start": "node index.js",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "types": "tsc",
        "types:no": "tsc --noEmit",
        "typespec": "tsp compile .",
        "docs": "typedoc --out dist/docs/ resources/js/",
        "typedoc": "npx typedoc",
        "typedoc-strategy": "npx typedoc --entryPointStrategy Expand resources/js",
        "sass:build": "sass resources/css/sass/tswitch.scss:resources/js/pages/themeswitcher/widget/tswitch.css --style=compressed --source-map",
